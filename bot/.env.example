# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here
DISCORD_GUILD_ID=your_test_server_id_here
# Found in Discord Developer Portal → App → General Information → "Public Key"
DISCORD_PUBLIC_KEY=your_discord_app_public_key_here

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role key for the bot (bypasses RLS for admin operations)
SUPABASE_KEY=your_supabase_service_role_key

# ─── API-Football (api-sports.io) ─────────────────────────────────────────────
API_FOOTBALL_KEY=your_api_sports_key_here

# ─── Vercel Cron (only needed in production) ──────────────────────────────────
# Set this to any random secret string, then add the same value in Vercel dashboard
CRON_SECRET=some_random_secret_string_here
